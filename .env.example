# Copy this file to .env and fill in the values.
# Or run  python .dev/init.py  to generate .env automatically.

# Supabase PostgreSQL connection string
# Get it from: Supabase → Connect → Transaction Pooler
DB_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Flask secret key – used for flash messages (auto-generated by init.py)
SECRET_KEY=change-me

# HMAC key for URL-safe user ID encoding (auto-generated by init.py)
ENCODING_SECRET=change-me

# How many days a login session stays valid
SESSION_LENGTH=7

# ── Google OAuth (only needed if you chose google or both) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
